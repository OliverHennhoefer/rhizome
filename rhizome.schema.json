{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rhizome.dev/schemas/config-v1.json",
  "title": "Rhizome configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["site", "content", "relations", "view"],
  "properties": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": { "title": { "type": "string", "minLength": 1 } }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "exclude": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "relations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "directed", "color"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "directed": { "type": "boolean" },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": { "default": { "enum": ["2d", "3d"] } }
    }
  }
}
