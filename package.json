{
  "name": "rhizome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "biome check . && tsc -b --pretty false",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "benchmark": "tsx scripts/benchmark.ts",
    "mcp:evaluate": "node --import tsx scripts/mcp-evaluate.ts",
    "mcp:integration": "node --import tsx scripts/mcp-integration.ts",
    "mcp:benchmark": "node --expose-gc --import tsx scripts/mcp-benchmark.ts",
    "mcp:dev": "WRANGLER_WRITE_LOGS=false wrangler dev",
    "mcp:check": "WRANGLER_WRITE_LOGS=false wrangler deploy --dry-run --outdir .rhizome-cache/worker",
    "mcp:deploy": "WRANGLER_WRITE_LOGS=false wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@quartz-community/rehype-obsidian": "^1.0.0",
    "@quartz-community/remark-obsidian": "^1.1.0",
    "agents": "^0.24.0",
    "ajv": "^8.17.1",
    "d3-force": "^3.0.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-layout-forceatlas2": "^0.10.1",
    "katex": "^0.18.7",
    "minisearch": "^7.2.0",
    "picomatch": "^4.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sigma": "^3.0.2",
    "stopword": "^3.1.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cloudflare/workers-types": "^5.20260911.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@playwright/test": "^1.63.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.13.4",
    "@types/picomatch": "^4.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/stopword": "^2.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "graphology-types": "^0.24.8",
    "miniflare": "^5.20260903.0-alpha",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.1"
  }
}
